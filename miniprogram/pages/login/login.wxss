.page {
  min-height: 100vh;
  padding: 96rpx 44rpx calc(56rpx + env(safe-area-inset-bottom));
  position: relative;
}

.bg {
  position: fixed;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(10rpx);
  opacity: 0.55;
}

.b1 {
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(232, 112, 63, 0.22), rgba(232, 112, 63, 0));
  top: -120rpx;
  right: -140rpx;
}

.b2 {
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(circle, rgba(47, 143, 98, 0.14), rgba(47, 143, 98, 0));
  bottom: -120rpx;
  left: -150rpx;
}

.brand {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 44rpx;
}

.logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #E8703F, #C2492A);
  color: #FFF8EF;
  font-size: 62rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 36rpx rgba(194, 73, 42, 0.3);
}

.bname {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.slogan {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9A9186;
  letter-spacing: 1rpx;
}

.panel {
  position: relative;
  z-index: 1;
  padding: 34rpx 32rpx 32rpx;
}

.tabs {
  display: flex;
  background: #F1EBE2;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #8C8377;
  padding: 14rpx 0;
  border-radius: 999rpx;
  transition: all 0.18s ease;
}

.tab.on {
  background: #FFFFFF;
  color: #201D18;
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(74, 54, 34, 0.08);
}

/* ---------- 微信登录 ---------- */
.wxbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  height: 92rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #1AAE62;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 26rpx rgba(26, 174, 98, 0.26);
}

.wxbtn-hover {
  opacity: 0.92;
}

.wxi {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  font-size: 20rpx;
  font-weight: 700;
}

.or {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 26rpx 0 24rpx;
}

.or-line {
  flex: 1;
  height: 1rpx;
  background: #EEE5D9;
}

.or-t {
  font-size: 21rpx;
  color: #B3A899;
}

.bindhead {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.bt {
  font-size: 32rpx;
  font-weight: 600;
}

.bs {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9A9186;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 22rpx;
  color: #9A9186;
  margin-bottom: 10rpx;
  padding-left: 6rpx;
}

.ipt {
  width: 100%;
  height: 92rpx;
  padding: 0 26rpx;
  background: #FAF6F0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #201D18;
}

.ipt-ph {
  color: #C9BEB0;
}

.err {
  background: #FDEDEA;
  color: #C2492A;
  font-size: 23rpx;
  line-height: 1.5;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 22rpx;
}

.submit {
  margin-top: 6rpx;
  width: 100%;
}

.links {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  font-size: 23rpx;
  color: #D9552F;
}

.skip {
  margin-top: 26rpx;
  text-align: center;
  font-size: 23rpx;
  color: #B9AE9F;
}

.foot {
  position: relative;
  z-index: 1;
  display: block;
  text-align: center;
  margin-top: 48rpx;
  font-size: 21rpx;
  color: #C9BEB0;
}
