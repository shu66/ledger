/* 登录 / 注册 / 绑定微信 —— 暖纸 + 墨字 + 陶土橙 */
.page {
  position: relative;
  min-height: 100vh;
  padding: 0 40rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #FBF7F1 0%, #F5EEE3 100%);
  overflow-x: hidden;
}

/* 背景光斑：固定定位 + 自身裁切，避免把页面撑出横向滚动 */
.bg {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.blob {
  position: absolute;
  border-radius: 50%;
}

.b1 {
  width: 520rpx;
  height: 520rpx;
  top: -190rpx;
  right: -190rpx;
  background: radial-gradient(circle at 35% 35%, rgba(217, 85, 47, 0.20), rgba(217, 85, 47, 0) 70%);
}

.b2 {
  width: 460rpx;
  height: 460rpx;
  bottom: -170rpx;
  left: -180rpx;
  background: radial-gradient(circle at 60% 40%, rgba(47, 143, 98, 0.12), rgba(47, 143, 98, 0) 70%);
}

/* ---------- 品牌区 ---------- */
.hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 0 42rpx;
}

.logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #E97445 0%, #C2492A 100%);
  box-shadow: 0 16rpx 32rpx rgba(194, 73, 42, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-t {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFF8EF;
  letter-spacing: 2rpx;
}

.bname {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #201D18;
}

.slogan {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #A2968A;
  letter-spacing: 1rpx;
}

/* ---------- 卡片 ---------- */
.panel {
  position: relative;
  z-index: 1;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 1rpx solid rgba(120, 95, 65, 0.07);
  box-shadow: 0 22rpx 60rpx rgba(87, 62, 38, 0.10);
  padding: 32rpx 30rpx 30rpx;
}

.tabs {
  display: flex;
  background: #F4EEE5;
  border-radius: 22rpx;
  padding: 6rpx;
  margin-bottom: 30rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #94897C;
  padding: 16rpx 0;
  border-radius: 18rpx;
  transition: all 0.18s ease;
}

.tab.on {
  background: #FFFFFF;
  color: #201D18;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(87, 62, 38, 0.08);
}

/* ---------- 微信登录 ---------- */
.wxbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  background: #F3FBF6;
  border: 1rpx solid #CFEBDC;
  color: #0E7A45;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: none;
}

.wxbtn-hover {
  background: #E8F7EF;
}

.wxi {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #1AAE62;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.or {
  display: flex;
  align-items: center;
  margin: 28rpx 0 26rpx;
}

.or-line {
  flex: 1;
  height: 1rpx;
  background: #F0E7DB;
}

.or-t {
  padding: 0 16rpx;
  font-size: 21rpx;
  color: #B4A899;
}

/* ---------- 绑定提示 ---------- */
.bindhead {
  display: flex;
  flex-direction: column;
  padding: 2rpx 2rpx 26rpx;
}

.bt {
  font-size: 32rpx;
  font-weight: 600;
  color: #201D18;
}

.bs {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9A9186;
}

/* ---------- 输入框 ---------- */
.field {
  margin-bottom: 22rpx;
}

.label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 10rpx 4rpx;
  font-size: 22rpx;
  color: #99897A;
  letter-spacing: 1rpx;
}

.hint {
  font-size: 20rpx;
  color: #C0B4A5;
  letter-spacing: 0;
}

.ibox {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 24rpx;
  background: #FAF6F0;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  transition: border-color 0.18s ease, background 0.18s ease;
}

.ibox.on {
  background: #FFFFFF;
  border-color: #E2703F;
}

.ipt {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0;
  font-size: 29rpx;
  color: #201D18;
  background: transparent;
}

.ipt-ph {
  color: #C6B9AA;
}

/* ---------- 错误提示 ---------- */
.err {
  display: flex;
  align-items: flex-start;
  margin: 2rpx 0 22rpx;
  padding: 18rpx 22rpx;
  background: #FDEDEA;
  border-radius: 16rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #B9452A;
}

.err-dot {
  width: 10rpx;
  height: 10rpx;
  margin: 10rpx 12rpx 0 0;
  border-radius: 50%;
  background: #D9552F;
  flex-shrink: 0;
}

/* ---------- 主按钮 ---------- */
.submit {
  width: 100%;
  height: 96rpx;
  margin-top: 8rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

/* ---------- 底部辅助链接 ---------- */
.links {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  font-size: 23rpx;
  color: #D9552F;
}

.skip {
  margin-top: 26rpx;
  text-align: center;
  font-size: 23rpx;
  color: #B9AE9F;
}

/* ---------- 页脚 ---------- */
.foot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 56rpx;
  font-size: 21rpx;
  color: #C0B4A5;
  letter-spacing: 1rpx;
}

.foot-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #D8CBB9;
}
