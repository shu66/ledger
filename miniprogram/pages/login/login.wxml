<view class="page" style="padding-top: {{topPad}}px">
  <view class="bg"><view class="blob b1"></view><view class="blob b2"></view></view>

  <view class="hero">
    <view class="logo"><text class="logo-t">账</text></view>
    <text class="bname">记账本</text>
    <text class="slogan">一句话，把每一笔记下来</text>
  </view>

  <!-- ① 微信登录：只放一个入口 -->
  <block wx:if="{{screen === 'wx' && mode !== 'bind'}}">
    <view class="panel wxpanel">
      <text class="wt">欢迎使用记账本</text>
      <text class="ws">用微信授权，一步进入你的账本</text>
      <button class="wxbtn big" bindtap="onWxLogin" loading="{{wxLoading}}" hover-class="wxbtn-big-hover">
        <view class="wxi">微</view>
        <text>微信一键登录</text>
      </button>
      <text class="wtip">第一次用会引导你绑定一个邮箱账号，之后直接进</text>
    </view>

    <view class="alt" bindtap="toEmail">
      <text class="alt-link">使用邮箱登录 / 注册</text>
    </view>
  </block>

  <!-- ② 邮箱登录 / 注册 / 绑定微信 -->
  <view class="panel" wx:else>
    <view class="backrow" wx:if="{{mode !== 'bind'}}" bindtap="toWx">
      <text class="backi">‹</text>
      <text class="backt">用微信登录</text>
    </view>

    <view class="bindhead" wx:if="{{mode === 'bind'}}">
      <text class="bt">绑定邮箱账号</text>
      <text class="bs">绑好后，下次打开微信直接进来</text>
    </view>

    <view class="tabs" wx:if="{{mode !== 'bind'}}">
      <view class="tab {{mode === 'login' ? 'on' : ''}}" data-m="login" bindtap="switchMode">登录</view>
      <view class="tab {{mode === 'register' ? 'on' : ''}}" data-m="register" bindtap="switchMode">注册</view>
    </view>

    <view class="field" bindtap="onFieldTap" data-k="email">
      <view class="label"><text>邮箱</text><text class="hint" wx:if="{{mode === 'login'}}">用注册时的邮箱</text></view>
      <view class="ibox {{focusKey === 'email' ? 'on' : ''}}">
        <input class="ipt" type="text" placeholder="you@example.com" placeholder-class="ipt-ph"
          value="{{email}}" data-k="email" bindinput="onInput" bindfocus="onFocus" bindblur="onBlur"
          focus="{{focusKey === 'email'}}" confirm-type="next" cursor-spacing="24" maxlength="190" />
      </view>
    </view>

    <view class="field" bindtap="onFieldTap" data-k="password">
      <view class="label"><text>密码</text><text class="hint" wx:if="{{mode === 'register'}}">至少 8 位</text></view>
      <view class="ibox {{focusKey === 'password' ? 'on' : ''}}">
        <input class="ipt" password placeholder="输入密码" placeholder-class="ipt-ph"
          value="{{password}}" data-k="password" bindinput="onInput" bindfocus="onFocus" bindblur="onBlur"
          focus="{{focusKey === 'password'}}" confirm-type="done" cursor-spacing="24" maxlength="72" />
      </view>
    </view>

    <view class="field" wx:if="{{mode === 'register'}}" bindtap="onFieldTap" data-k="nickname">
      <view class="label"><text>昵称</text><text class="hint">可以不填</text></view>
      <view class="ibox {{focusKey === 'nickname' ? 'on' : ''}}">
        <input class="ipt" placeholder="怎么称呼你" placeholder-class="ipt-ph"
          value="{{nickname}}" data-k="nickname" bindinput="onInput" bindfocus="onFocus" bindblur="onBlur"
          focus="{{focusKey === 'nickname'}}" confirm-type="done" cursor-spacing="24" maxlength="24" />
      </view>
    </view>

    <view class="err" wx:if="{{err}}">
      <text class="err-dot"></text>
      <text>{{err}}</text>
    </view>

    <button class="btn-primary submit" loading="{{loading}}" bindtap="submit">
      {{mode === 'bind' ? '绑定并登录' : (mode === 'register' ? '注册并登录' : '登录')}}
    </button>

    <view class="links" wx:if="{{mode === 'bind'}}">
      <text bindtap="switchMode" data-m="login">已有账号，直接登录</text>
      <text bindtap="switchMode" data-m="register">注册新账号</text>
    </view>

    <view class="skip" wx:if="{{mode === 'bind'}}" bindtap="skipBind">先不绑定，用邮箱进</view>
  </view>

  <view class="foot">
    <text class="foot-dot"></text>
    <text>数据存在你自己的服务器 · 断网也能记</text>
  </view>
</view>
