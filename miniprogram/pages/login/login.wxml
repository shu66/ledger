<view class="page">
  <view class="bg"><view class="blob b1"></view><view class="blob b2"></view></view>

  <view class="brand">
    <view class="logo">账</view>
    <text class="bname">记账本</text>
    <text class="slogan">一句话，把每一笔记下来</text>
  </view>

  <view class="panel card">
    <view class="tabs" wx:if="{{mode !== 'bind'}}">
      <view class="tab {{mode === 'login' ? 'on' : ''}}" data-m="login" bindtap="switchMode">登录</view>
      <view class="tab {{mode === 'register' ? 'on' : ''}}" data-m="register" bindtap="switchMode">注册</view>
    </view>
    <view class="bindhead" wx:else>
      <text class="bt">绑定邮箱账号</text>
      <text class="bs">绑好后，下次打开微信直接进来</text>
    </view>

    <button class="wxbtn" wx:if="{{mode !== 'bind'}}" bindtap="onWxLogin"
      loading="{{wxLoading}}" hover-class="wxbtn-hover">
      <text class="wxi">微信</text>
      <text>微信一键登录</text>
    </button>

    <view class="or" wx:if="{{mode !== 'bind'}}">
      <view class="or-line"></view>
      <text class="or-t">或使用邮箱密码</text>
      <view class="or-line"></view>
    </view>

    <view class="field">
      <text class="label">邮箱</text>
      <input class="ipt" type="text" placeholder="you@example.com" placeholder-class="ipt-ph"
        value="{{email}}" data-k="email" bindinput="onInput" cursor-spacing="24" />
    </view>

    <view class="field">
      <text class="label">密码</text>
      <input class="ipt" password placeholder="{{mode === 'register' ? '至少 8 位' : '你的密码'}}"
        placeholder-class="ipt-ph" value="{{password}}" data-k="password" bindinput="onInput" cursor-spacing="24" />
    </view>

    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="label">昵称</text>
      <input class="ipt" placeholder="可选，方便称呼" placeholder-class="ipt-ph"
        value="{{nickname}}" data-k="nickname" bindinput="onInput" cursor-spacing="24" />
    </view>

    <view class="err" wx:if="{{err}}">{{err}}</view>

    <button class="btn-primary submit" loading="{{loading}}" bindtap="submit">
      {{mode === 'bind' ? '绑定并登录' : (mode === 'register' ? '注册' : '登录')}}
    </button>

    <view class="links" wx:if="{{mode === 'bind'}}">
      <text bindtap="switchMode" data-m="login">已有账号，直接登录</text>
      <text bindtap="switchMode" data-m="register">注册新账号</text>
    </view>

    <view class="skip" wx:if="{{mode === 'bind'}}" bindtap="skipBind">先不绑定，用邮箱进</view>
  </view>

  <text class="foot">数据只存在你自己的服务器</text>
</view>
