.page {
  padding: 24rpx 28rpx 40rpx;
}

/* 本地待同步提示 */
.pending-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #FBF0DC;
  color: #8A5A0F;
  font-size: 24rpx;
}
.pending-bar .pending-act {
  flex: 0 0 auto;
  font-weight: 600;
  color: #D9552F;
}

/* ---------- 顶部账本卡片 ---------- */
.hero {
  background: radial-gradient(120% 120% at 100% 0%, #5C4838 0%, #33291F 55%, #251E18 100%);
  border-radius: 36rpx;
  padding: 34rpx 36rpx 32rpx;
  color: #F7EFE4;
  box-shadow: 0 22rpx 44rpx rgba(46, 38, 32, 0.22);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hello {
  font-size: 28rpx;
  opacity: 0.85;
}

.date {
  font-size: 23rpx;
  opacity: 0.5;
}

.hero-main {
  display: flex;
  align-items: baseline;
  margin-top: 28rpx;
}

.cur {
  font-size: 34rpx;
  opacity: 0.65;
  margin-right: 8rpx;
}

.num {
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  opacity: 0.55;
}

/* ---------- 输入区 ---------- */
.composer {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 24rpx;
}

.ta {
  width: 100%;
  min-height: 92rpx;
  font-size: 30rpx;
  line-height: 1.55;
}

.ph {
  color: #B9AE9F;
}

.composer-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.ai-tip {
  font-size: 22rpx;
  color: #A89C8D;
}

.send {
  background: #F1EBE2;
  color: #B9AE9F;
  border-radius: 999rpx;
  padding: 14rpx 34rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.send.on {
  background: linear-gradient(135deg, #E8703F, #D9552F);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(217, 85, 47, 0.3);
}

.chips {
  margin-top: 18rpx;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  background: #EFE7DC;
  color: #7A6F62;
  font-size: 23rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  margin-right: 14rpx;
}

/* ---------- 解析中 ---------- */
.thinking {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D9552F;
  margin-right: 10rpx;
  animation: blink 1.1s infinite ease-in-out;
}

.dot.d2 { animation-delay: 0.18s; }
.dot.d3 { animation-delay: 0.36s; }

.thinking-t {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #9A9186;
}

@keyframes blink {
  0%, 100% { opacity: 0.25; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-4rpx); }
}

/* ---------- 解析结果卡片 ---------- */
.draft {
  margin-top: 20rpx;
  padding: 26rpx 28rpx 22rpx;
}

.draft-top {
  display: flex;
  align-items: center;
}

.ico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #FBF2EA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.ico.small {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
}

.mid {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.amt {
  display: flex;
  align-items: baseline;
}

.sym {
  font-size: 28rpx;
  color: #9A9186;
  margin-right: 4rpx;
}

.amt-in {
  flex: 1;
  height: 62rpx;
  font-size: 48rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.meta {
  font-size: 23rpx;
  color: #9A9186;
  margin-top: 2rpx;
}

.warn {
  color: #C98A2E;
}

.x {
  color: #C9BEB0;
  font-size: 28rpx;
  padding: 12rpx 0 12rpx 22rpx;
}

.draft-foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F4EDE4;
}

.pick {
  font-size: 23rpx;
  color: #D9552F;
  background: #FBE9E2;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.note {
  flex: 1;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #9A9186;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.confirm-wrap {
  margin-top: 26rpx;
}

/* ---------- 最近记录 ---------- */
.section {
  margin-top: 40rpx;
}

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 14rpx;
  font-size: 25rpx;
  color: #7A6F62;
}

.sec-head .more {
  color: #B9AE9F;
  font-size: 23rpx;
}

.list {
  padding: 6rpx 26rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F6F0E8;
}

.row:last-child {
  border-bottom: 0;
}

.rmid {
  flex: 1;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.rname {
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rsub {
  font-size: 22rpx;
  color: #B9AE9F;
  margin-top: 4rpx;
}

.ramt {
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.safe {
  height: 40rpx;
}

/* 分类选择浮层（替代最多 6 项的 showActionSheet） */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(32, 29, 24, .42);
  z-index: 40;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  background: #FFFDF9;
  border-radius: 28rpx 28rpx 0 0;
  padding: 26rpx 26rpx calc(34rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 48rpx rgba(40, 30, 20, .18);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx 18rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #201D18;
}

.sheet-close {
  font-size: 26rpx;
  color: #D9552F;
  padding: 6rpx 10rpx;
}

.sheet-body {
  max-height: 52vh;
}

.sheet-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.sheet-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 6rpx;
  border-radius: 18rpx;
  background: #F7F2EA;
  border: 2rpx solid transparent;
}

.sheet-item.on {
  border-color: #D9552F;
  background: #FBEDE6;
}

.sheet-item.add {
  border: 2rpx dashed #D8C7B4;
  background: transparent;
}
.sheet-item.add .si-ico {
  color: #D9552F;
  font-weight: 600;
}
.sheet-item.add .si-name {
  color: #D9552F;
}

.si-ico {
  font-size: 34rpx;
  line-height: 1.1;
}

.si-name {
  font-size: 22rpx;
  color: #4A4238;
}
