.page {
  padding: 20rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 月份切换 ---------- */
.monthbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  padding: 12rpx 0 22rpx;
}

.mtitle {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.arrow {
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFFFFF;
  color: #6B6258;
  font-size: 34rpx;
  box-shadow: 0 6rpx 16rpx rgba(74, 54, 34, 0.06);
}

.arrow.off {
  color: #D9CFC1;
  background: #F1EBE2;
  box-shadow: none;
}

/* ---------- 汇总 ---------- */
.summary {
  padding: 30rpx 30rpx 26rpx;
}

.srow {
  display: flex;
}

.scol {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sl {
  font-size: 22rpx;
  color: #9A9186;
}

.sv {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.bars {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F4EDE4;
}

.bar-item {
  margin-bottom: 18rpx;
}

.bar-item:last-child {
  margin-bottom: 0;
}

.bi-top {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  color: #7A6F62;
  margin-bottom: 10rpx;
}

.bi-num {
  font-variant-numeric: tabular-nums;
}

.track {
  height: 10rpx;
  border-radius: 999rpx;
  background: #F4EDE4;
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #F0A07E, #D9552F);
}

/* ---------- 按天分组 ---------- */
.group {
  margin-top: 32rpx;
}

.gh {
  display: flex;
  align-items: baseline;
  padding: 0 8rpx 12rpx;
}

.gl {
  font-size: 25rpx;
  color: #201D18;
  font-weight: 600;
}

.gw {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: #B9AE9F;
}

.gd {
  margin-left: auto;
  font-size: 21rpx;
  color: #B9AE9F;
  font-variant-numeric: tabular-nums;
}

.gcard {
  padding: 4rpx 26rpx;
}

.grow {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F6F0E8;
}

.grow:last-child {
  border-bottom: 0;
}

.ico {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: #FBF2EA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.gmid {
  flex: 1;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.gname {
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gsub {
  font-size: 21rpx;
  color: #B9AE9F;
  margin-top: 4rpx;
}

.gamt {
  font-size: 29rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.tip {
  text-align: center;
  font-size: 21rpx;
  color: #C9BEB0;
  padding: 30rpx 0 0;
}

.logout {
  margin-top: 56rpx;
  text-align: center;
  font-size: 25rpx;
  color: #9A9186;
  padding: 24rpx 0;
}

.safe {
  height: 20rpx;
}

/* ---------- 区间 / 搜索 / 待同步 / 浮层 ---------- */
.pending-bar {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  margin-bottom: 18rpx; padding: 18rpx 22rpx; border-radius: 18rpx;
  background: #FBF0DC; color: #8A5A0F; font-size: 24rpx;
}
.pending-bar .pending-act { flex: 0 0 auto; font-weight: 600; color: #D9552F; }

.period-seg {
  display: flex; gap: 8rpx; padding: 8rpx; border-radius: 20rpx;
  background: #EFE7DB; margin-bottom: 6rpx;
}
.seg-i {
  flex: 1; text-align: center; padding: 14rpx 0; border-radius: 15rpx;
  font-size: 25rpx; color: #6B6258;
}
.seg-i.on { background: #FFFFFF; color: #201D18; font-weight: 600; box-shadow: 0 4rpx 12rpx rgba(74,54,34,.08); }

.monthbar { padding: 18rpx 0 16rpx; }

.custom-dates { display: flex; align-items: center; justify-content: center; gap: 14rpx; margin-bottom: 12rpx; }
.date-btn {
  padding: 14rpx 22rpx; border-radius: 16rpx; background: #FFFFFF;
  font-size: 25rpx; color: #3A342C; box-shadow: 0 6rpx 16rpx rgba(74,54,34,.05);
}
.custom-dates .dash { color: #A79B8B; font-size: 24rpx; }

.searchbox {
  display: flex; align-items: center; gap: 10rpx;
  background: #FFFFFF; border-radius: 18rpx; padding: 16rpx 22rpx; margin-bottom: 20rpx;
}
.searchbox .sicon { font-size: 24rpx; opacity: .5; }
.searchbox .sinput { flex: 1; height: 56rpx; font-size: 26rpx; color: #201D18; }
.searchbox .sph { color: #A79B8B; }
.searchbox .sclear { color: #A79B8B; font-size: 26rpx; padding: 0 6rpx; }

.count-line { font-size: 22rpx; color: #A79B8B; margin-top: 14rpx; }

.sheet-mask { position: fixed; inset: 0; background: rgba(28,22,16,.42); z-index: 40; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 41;
  background: #FFFDF9; border-radius: 34rpx 34rpx 0 0;
  padding: 22rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  max-height: 62vh; display: flex; flex-direction: column;
}
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 6rpx 4rpx 18rpx; }
.sheet-title { font-size: 30rpx; font-weight: 600; }
.sheet-done { font-size: 26rpx; color: #D9552F; }
.sheet-body { flex: 1; min-height: 0; }
.sheet-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; padding-bottom: 10rpx; }
.sheet-item {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 20rpx 6rpx; border-radius: 20rpx; background: #F7F1E7;
  border: 2rpx solid transparent;
}
.sheet-item .si-ico { font-size: 34rpx; }
.sheet-item .si-name { font-size: 22rpx; color: #3A342C; }
/* ---------- 统计视图 ---------- */
.view-seg { margin: 6rpx 0 20rpx; }

.chart { padding: 28rpx 28rpx 24rpx; margin-bottom: 20rpx; }

.ch-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20rpx; }
.ch-title { font-size: 28rpx; font-weight: 600; color: #201D18; }
.ch-sub { font-size: 21rpx; color: #A79C8F; }

.trend { display: flex; align-items: flex-end; height: 250rpx; gap: 10rpx; }
.tcol { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.tbars { display: flex; align-items: flex-end; gap: 6rpx; height: 200rpx; }
.tbar { width: 18rpx; border-radius: 8rpx 8rpx 2rpx 2rpx; }
.tbar.out { background: linear-gradient(180deg, #E8744F, #D9552F); }
.tbar.in { background: linear-gradient(180deg, #4FA97C, #2F8F62); }
.tlabel { margin-top: 12rpx; font-size: 20rpx; color: #A79C8F; }

.legend { display: flex; align-items: center; justify-content: center; margin-top: 8rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 8rpx; }
.dot.out { background: #D9552F; }
.dot.in { background: #2F8F62; }
.lg { font-size: 21rpx; color: #8A8074; margin-right: 26rpx; }

.days { display: flex; align-items: flex-end; height: 190rpx; gap: 4rpx; }
.dcol { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.dbar { width: 100%; max-width: 18rpx; background: #E8906F; border-radius: 6rpx 6rpx 2rpx 2rpx; }
.dlabel { margin-top: 8rpx; font-size: 17rpx; color: #B3A899; }

.catline { padding: 14rpx 0; border-bottom: 1rpx solid #F6F0E8; }
.catline:last-child { border-bottom: none; }
.cl-top { display: flex; justify-content: space-between; align-items: baseline; }
.cl-name { font-size: 26rpx; color: #2B2620; }
.cl-num { font-size: 23rpx; color: #6B6258; }
.cl-track { margin-top: 12rpx; height: 12rpx; border-radius: 999rpx; background: #F4EDE4; overflow: hidden; }
.cl-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #F0A184, #D9552F); }
.cl-n { display: block; margin-top: 8rpx; font-size: 20rpx; color: #B3A899; }

.filter-chip { display: inline-flex; align-items: center; gap: 12rpx; margin: 4rpx 0 16rpx; padding: 10rpx 22rpx; border-radius: 999rpx; background: #FBE9E2; color: #C24A26; font-size: 23rpx; }
.fc-x { font-size: 22rpx; }
