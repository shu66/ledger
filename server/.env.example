# 签发访问令牌，>= 32 字符
JWT_SECRET=please_replace_with_openssl_rand_hex_32

# 加密数据库里的模型 API Key。设定后不可更换，否则旧 Key 解不开
APP_SECRET=please_replace_with_openssl_rand_hex_32

APP_PUBLIC_URL=http://localhost:3000
APP_ADMIN_EMAIL=

# 放在 Nginx / 反代后面时设为 true，限流和审计日志才会取 X-Forwarded-For
APP_TRUST_PROXY=false

# 每人每天的 AI 次数（解析 / 总结）
AI_PARSE_DAILY=50
AI_SUMMARY_DAILY=20

WX_APPID=wx0000000000000000
WX_SECRET=替换为小程序后台的 AppSecret

# 本机跑 mvn 时用；Docker 里由 compose 覆盖
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ledger?useUnicode=true&characterEncoding=utf8&connectionTimeZone=%2B08:00&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=ledger
SPRING_DATASOURCE_PASSWORD=ledger
